{
  "name": "yamori",
  "displayName": "Yamori",
  "description": "Programming context, made explicit. Read code as friendly, navigable pseudocode in Cursor and VS Code.",
  "version": "0.19.1",
  "publisher": "cowana-ai",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Visualization"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Read and explain source in Restricted Mode through isolated, tool-disabled AI sessions. Project settings and language-service definition lookups are not used.",
      "restrictedConfigurations": [
        "yamori.codexPath",
        "yamori.claudePath",
        "yamori.refinementSteps"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "yamori.read",
        "title": "Yamori: Read as Pseudocode",
        "icon": "$(yamori-gecko)"
      },
      {
        "command": "yamori.browse",
        "title": "Yamori: Choose a File"
      },
      {
        "command": "yamori.project",
        "title": "Yamori: Read a Folder or Project"
      },
      {
        "command": "yamori.provider",
        "title": "Yamori: Choose Provider"
      },
      {
        "command": "yamori.connectClaude",
        "title": "Yamori: Connect Claude"
      },
      {
        "command": "yamori.clear",
        "title": "Yamori: Clear Cached Explanations"
      },
      {
        "command": "yamori.model",
        "title": "Yamori: Choose Model"
      },
      {
        "command": "yamori.effort",
        "title": "Yamori: Choose Effort"
      },
      {
        "command": "yamori.colors",
        "title": "Yamori: Choose Reading Colors"
      },
      {
        "command": "yamori.switchFile",
        "title": "Yamori: Switch Files",
        "icon": "$(files)"
      },
      {
        "command": "yamori.refinement",
        "title": "Yamori: Choose Refinement Steps"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "yamori.read",
          "when": "resourceScheme == file || resourceScheme == untitled",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "yamori.read",
          "when": "resourceScheme == file",
          "group": "yamori"
        }
      ],
      "explorer/context": [
        {
          "command": "yamori.read",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "yamori"
        },
        {
          "command": "yamori.project",
          "when": "explorerResourceIsFolder",
          "group": "yamori"
        }
      ]
    },
    "keybindings": [
      {
        "command": "yamori.read",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "configuration": {
      "title": "Yamori",
      "properties": {
        "yamori.codexPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to Codex CLI. Otherwise detected automatically."
        },
        "yamori.claudePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to Claude Code CLI."
        },
        "yamori.refinementSteps": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "description": "Maximum refinement steps for difficult blocks. A selector skips straightforward functions; two parallel evaluators check uncertainty and reading cost. Up to 3N+4 model requests per new explanation, or 2 if no hard blocks. 0 skips selection and refinement. Cached reads use no AI."
        }
      }
    },
    "icons": {
      "yamori-gecko": {
        "description": "Yamori gecko",
        "default": {
          "fontPath": "./yamori-icons.woff",
          "fontCharacter": "\\e001"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test.js",
    "check": "node --check extension.js && node --check engine.js && node --check panel.js && node --check cache.js"
  },
  "files": [
    "extension.js",
    "engine.js",
    "panel.js",
    "README.md",
    "demo.py",
    "yamori.png",
    "katex.min.js",
    "LICENSE",
    "yamori-icons.woff",
    "editor.min.js",
    "cache.js",
    "diff.min.js"
  ],
  "icon": "yamori.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cowana-ai/yamori.git"
  },
  "homepage": "https://github.com/cowana-ai/yamori#readme",
  "bugs": {
    "url": "https://github.com/cowana-ai/yamori/issues"
  },
  "keywords": [
    "pseudocode",
    "code-understanding",
    "cursor",
    "codex",
    "claude"
  ]
}
